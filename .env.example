# Where the memory database and token cache live
JARVIS_DATA_DIR=~/Library/Application Support/JARVIS

# Apple Mail account JARVIS sends from / reads
MAIL_ACCOUNT=

# Microsoft Graph (school Outlook) — from your Entra app registration
GRAPH_CLIENT_ID=
# "organizations" works for any work/school account; use your school's tenant ID if that fails
GRAPH_TENANT=organizations

# Later phases
CANVAS_BASE_URL=https://canvas.seattlecolleges.edu
TIMEZONE=America/Los_Angeles
QUIET_HOURS=23-7
# Seattle Colleges blocks personal tokens; use the Calendar Feed link instead
CANVAS_ICS_URL=
CANVAS_TOKEN=
# Telegram: approvals + alerts (free). Token from @BotFather; chat id is filled by `jarvis telegram-setup`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Chat model via the local Claude Code CLI (sonnet or haiku)
JARVIS_MODEL=sonnet
# Twilio: voice only (urgent calls to you, and calling JARVIS); no 10DLC needed
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MY_PHONE_NUMBER=
# Calling JARVIS from your cell: the tunnel's https address (README: Calling JARVIS)
PHONE_PUBLIC_URL=
PHONE_PORT=8787
# Digits to key in after JARVIS picks up (recommended: caller ID can be faked)
PHONE_PIN=
ANTHROPIC_API_KEY=

# Jev (TypeSafe) for fast decisions and context routing; empty = Claude only
TYPESAFE_API_KEY=
JUDGE_ENGINE=auto

# Background jobs: ping once if a job prints nothing this long (minutes)
JOB_STALL_MINUTES=10
# Location from Telegram shares (kept locally; Nominatim gets rounded coordinates for place names)
LOCATION=1
LOCATION_GEOCODE=1
LOCATION_STALE_MINUTES=30
