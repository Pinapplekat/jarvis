# Where the memory database and token cache live
JARVIS_DATA_DIR=~/Library/Application Support/JARVIS

# Apple Mail account JARVIS sends from / reads
MAIL_ACCOUNT=

# Microsoft Graph (school Outlook) — from your Entra app registration
GRAPH_CLIENT_ID=
# "organizations" works for any work/school account; use your school's tenant ID if that fails
GRAPH_TENANT=organizations

# Later phases
CANVAS_BASE_URL=https://canvas.seattlecolleges.edu
TIMEZONE=America/Los_Angeles
QUIET_HOURS=23-7
# Seattle Colleges blocks personal tokens; use the Calendar Feed link instead
CANVAS_ICS_URL=
CANVAS_TOKEN=
# Telegram: approvals + alerts (free). Token from @BotFather; chat id is filled by `jarvis telegram-setup`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Chat model via the local Claude Code CLI (sonnet or haiku)
JARVIS_MODEL=sonnet
# Twilio: voice only (urgent calls to you, and calling JARVIS); no 10DLC needed
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MY_PHONE_NUMBER=
# Calling JARVIS from your cell: the tunnel's https address (README: Calling JARVIS)
PHONE_PUBLIC_URL=
PHONE_PORT=8787
# Digits to key in after JARVIS picks up (recommended: caller ID can be faked)
PHONE_PIN=
ANTHROPIC_API_KEY=

# Jev (TypeSafe) for fast decisions and context routing; empty = Claude only
TYPESAFE_API_KEY=
JUDGE_ENGINE=auto

# Background jobs: ping once if a job prints nothing this long (minutes)
JOB_STALL_MINUTES=10
# Location from Telegram shares (kept locally; Nominatim gets rounded coordinates for place names)
LOCATION=1
LOCATION_GEOCODE=1
LOCATION_STALE_MINUTES=30
# Street address of your latest point (Nominatim, 5-decimal coordinates, once a minute at most; 0 = off)
REVERSE_GEOCODE=1

# Task mode: a sandboxed Claude Code session per task (0 = off)
TASKS=1
TASK_MODEL=sonnet
TASK_MAX_TURNS=40
TASK_MAX_MINUTES=20
# JARVIS approves helpers' high-risk steps itself when off your side of the line (0 = always ask you)
SELF_APPROVE=1
SELF_APPROVE_CONFIDENCE=0.8
# Self-edit build session: restart it if it prints nothing this long (minutes)
BUILD_HANG_MINUTES=10

# Thinking heartbeat (0 = off; "pause heartbeat" in chat pauses it)
HEARTBEAT=1
HEARTBEAT_MIN_INTERVAL_MIN=30
HEARTBEAT_MAX_RUNS_PER_DAY=24
HEARTBEAT_MAX_MSGS_PER_DAY=3
HEARTBEAT_MIN_MSG_GAP_MIN=90
HEARTBEAT_MODEL=haiku

# Extra domains JARVIS's browser must never open (banks and payment sites are built in)
BROWSER_BLOCKLIST=
